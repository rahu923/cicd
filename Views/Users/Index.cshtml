@model IReadOnlyList<cicd.Repositories.UserSummary>
@{ ViewData["Title"] = "Users"; var page = (int)ViewData["Page"]!; }
<h1>Users</h1>
<table class="table">
    <thead><tr><th>Email</th><th>Roles</th></tr></thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr><td>@user.Email</td><td>@string.Join(", ", user.Roles)</td></tr>
    }
    </tbody>
</table>
<nav aria-label="User pages">
    @if (page > 1) { <a asp-action="Index" asp-route-page="@(page - 1)">Previous</a> }
    <span class="mx-3">Page @(page)</span>
    @if (Model.Count == 50 && page < 10000) { <a asp-action="Index" asp-route-page="@(page + 1)">Next</a> }
</nav>
